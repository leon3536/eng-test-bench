# Pre-baked goose 1.57.0 (goose-skip): Harbor 0.25.0's own setup() execs for this task image,
# one RUN each, byte for byte. Generated by bench.prebake; build with --build-arg BASE=<task image>.
ARG BASE
FROM ${BASE}
RUN ["bash", "-c", "[ -d /installed-agent ] || mkdir -p /installed-agent"]
RUN ["env", "DEBIAN_FRONTEND=noninteractive", "bash", "-c", "set -o pipefail; apt-get update && apt-get install -y curl bzip2 libxcb1 libgomp1"]
RUN ["env", "GOOSE_DISABLE_KEYRING=true", "CONFIGURE=false", "bash", "-c", "set -o pipefail; mkdir -p ~/.config/goose && cat > ~/.config/goose/config.yaml << 'INNEREOF'\nGOOSE_MODEL: ${GOOSE_MODEL}\nGOOSE_PROVIDER: ${GOOSE_PROVIDER}\nextensions:\n  developer:\n    bundled: true\n    display_name: Developer\n    enabled: true\n    name: developer\n    timeout: 300\n    type: builtin\n  todo:\n    bundled: true\n    display_name: Todo\n    enabled: true\n    name: todo\n    type: platform\n  summon:\n    bundled: true\n    display_name: Summon\n    enabled: true\n    name: summon\n    type: platform\nINNEREOF"]
RUN ["env", "GOOSE_DISABLE_KEYRING=true", "CONFIGURE=false", "GOOSE_VERSION=v1.57.0", "bash", "-c", "set -o pipefail; set -euo pipefail; curl -fsSL https://github.com/block/goose/releases/download/v1.57.0/download_cli.sh | bash && export PATH=\"$HOME/.local/bin:$PATH\" && goose --version"]
