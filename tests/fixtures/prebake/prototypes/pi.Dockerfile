# Copied from the research prototype prebake/pi/Dockerfile.pi-warm (fix-git), the Dockerfile the
# probes built and proved. Only its ARG/FROM lines are normalized to ARG BASE.
# Pre-baked (warm) Pi 1.4.0: everything but the global package. Generated by gen_dockerfile_warm.py.
ARG BASE
FROM ${BASE}
RUN ["bash", "-c", "[ -d /installed-agent ] || mkdir -p /installed-agent"]
RUN ["bash", "-c", "command -v curl >/dev/null 2>&1 || { command -v apt-get >/dev/null 2>&1 || { echo 'prebake: only apt-get images handled' >&2; exit 1; }; DEBIAN_FRONTEND=noninteractive bash -c 'set -o pipefail; apt-get update && apt-get install -y curl'; }"]
RUN ["bash", "-c", "set -o pipefail; set -euo pipefail; curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.2/install.sh | env -u NODE_VERSION bash && export NVM_DIR=\"$HOME/.nvm\" && \\. \"$NVM_DIR/nvm.sh\" || true && command -v nvm &>/dev/null || { echo 'Error: NVM failed to load' >&2; exit 1; } && nvm install 22 && nvm alias default 22 && npm -v && npm install -g --ignore-scripts @earendil-works/pi-coding-agent@1.4.0 && pi --version && P=\"$(npm config get prefix)\" && rm -rf \"$P/lib/node_modules/@earendil-works\" \"$P/bin/pi\" \"$HOME/.npm/_logs\" /tmp/node-compile-cache && test ! -e \"$P/bin/pi\""]
